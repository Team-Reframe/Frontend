<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.scan.RewardActivity">

    <!-- 상자 클릭 전 UI -->
    <TextView
        android:id="@+id/textClickBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="상자를 클릭해주세요!"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/imageBoxClosed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="24dp"/>

    <ImageView
        android:id="@+id/imageBoxClosed"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_gift_box_closed"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="선물 상자" />

    <!-- 상자 클릭 후 UI -->
    <TextView
        android:id="@+id/textRewardMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/lottieBoxOpen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="24dp"
        tools:text="100p를 받았어요!"
        tools:visibility="visible"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieBoxOpen"
        android:layout_width="300dp"
        android:layout_height="300dp"
        app:lottie_rawRes="@raw/confetti_animation"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textPoints"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFC107"
        android:textSize="34sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/lottieBoxOpen"
        app:layout_constraintBottom_toBottomOf="@+id/lottieBoxOpen"
        app:layout_constraintStart_toStartOf="@+id/lottieBoxOpen"
        app:layout_constraintEnd_toEndOf="@+id/lottieBoxOpen"
        tools:text="+100p"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>